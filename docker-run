#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
mkdir -p "${SCRIPT_DIR}/.cache/torch/hub/checkpoints"
mkdir -p "${SCRIPT_DIR}/.cache/huggingface"

if [ $# -eq 0 ]; then
    docker run --gpus all --rm -it \
        -v "${SCRIPT_DIR}:/app" \
        -v "${SCRIPT_DIR}/.cache/torch/hub/checkpoints:/root/.cache/torch/hub/checkpoints" \
        -v "${SCRIPT_DIR}/.cache/huggingface:/root/.cache/huggingface" \
        -p 7861:7860 \
        make-voice:hebtts python GradioPage.py
else
    docker run --gpus all --rm -it \
        -v "${SCRIPT_DIR}:/app" \
        -v "${SCRIPT_DIR}/.cache/torch/hub/checkpoints:/root/.cache/torch/hub/checkpoints" \
        -v "${SCRIPT_DIR}/.cache/huggingface:/root/.cache/huggingface" \
        make-voice:hebtts "$@"
fi
