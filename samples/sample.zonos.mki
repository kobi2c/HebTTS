!{"engine": "zonos", "model_choice": "notmax123/Zonos-Hebrew", "language": "he", "speaker": "shaul", "emotions": [1.0, 0.05, 0.05, 0.05, 0.05, 0.05, 0.05, 0.2], "cfg_scale": 2.0, "speaking_rate": 14.5}
